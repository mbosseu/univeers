{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/notify/?$",
			"dest": "_render"
		},
		{
			"src": "^/assistant/?$",
			"dest": "_render"
		},
		{
			"src": "^/badges/?$",
			"dest": "_render"
		},
		{
			"src": "^/capsules/?$",
			"dest": "_render"
		},
		{
			"src": "^/dashboard/?$",
			"dest": "_render"
		},
		{
			"src": "^/journal/?$",
			"dest": "_render"
		},
		{
			"src": "^/love-languages/?$",
			"dest": "_render"
		},
		{
			"src": "^/messages/?$",
			"dest": "_render"
		},
		{
			"src": "^/onboarding/?$",
			"dest": "_render"
		},
		{
			"src": "^/rituals/?$",
			"dest": "_render"
		},
		{
			"src": "^/settings/?$",
			"dest": "_render"
		},
		{
			"src": "^/souvenirs/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}