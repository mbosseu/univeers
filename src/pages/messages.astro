---
import AppLayout from '../layouts/AppLayout.astro';
import ChatComponent from '../components/Chat.jsx';
---

<AppLayout title="Notre Discussion">
	<ChatComponent client:load />
</AppLayout>

<style is:global>
	/* Full height chat layout */
	.chat-container {
		display: flex;
		flex-direction: column;
		height: 100vh;
		max-width: 600px;
		margin: 0 auto;
		width: 100%;
		background-color: var(--color-background);
	}

	.chat-header {
		display: flex;
		align-items: center;
		padding: 1rem;
		background-color: var(--color-white);
		box-shadow: var(--shadow-sm);
		border-bottom: 1px solid rgba(169, 27, 34, 0.05);
		z-index: 10;
	}

	.back-arrow-btn {
		font-size: 1.5rem;
		color: var(--color-text);
		margin-right: 1rem;
		font-weight: bold;
		text-decoration: none;
		width: 30px;
		height: 30px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		transition: background-color 0.2s;
	}

	.back-arrow-btn:hover {
		background-color: rgba(169, 27, 34, 0.05);
	}

	.partner-status {
		display: flex;
		align-items: center;
		gap: 0.8rem;
	}

	.partner-avatar {
		width: 40px;
		height: 40px;
		background-color: rgba(169, 27, 34, 0.05);
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.25rem;
		box-shadow: var(--shadow-sm);
	}

	.partner-status h3 {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--color-text);
	}

	.status-indicator {
		margin: 0;
		font-size: 0.75rem;
		color: var(--color-text-light);
		display: flex;
		align-items: center;
		gap: 4px;
	}

	.status-dot {
		width: 6px;
		height: 6px;
		background-color: #2e7d32;
		border-radius: 50%;
		display: inline-block;
	}

	/* Message Feed */
	.messages-feed {
		flex-grow: 1;
		overflow-y: auto;
		padding: 1.5rem 1rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.chat-empty {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		height: 100%;
		color: var(--color-text-light);
		text-align: center;
		padding: 2rem;
	}

	.chat-empty p {
		font-weight: 600;
		font-size: 1rem;
		margin: 0;
	}

	.chat-empty .subtext {
		font-size: 0.85rem;
		opacity: 0.8;
		margin-top: 4px;
	}

	.msg-wrapper {
		display: flex;
		width: 100%;
	}

	.msg-me {
		justify-content: flex-end;
	}

	.msg-partner {
		justify-content: flex-start;
	}

	.msg-bubble {
		position: relative;
		padding: 10px 14px;
		border-radius: var(--radius-lg);
		max-width: 80%;
		line-height: 1.4;
		font-size: 0.95rem;
		box-shadow: var(--shadow-sm);
		display: flex;
		flex-direction: column;
	}

	.msg-me .msg-bubble {
		background-color: var(--color-primary);
		color: var(--color-white);
		border-bottom-right-radius: 4px;
	}

	.msg-partner .msg-bubble {
		background-color: var(--color-white);
		color: var(--color-text);
		border-bottom-left-radius: 4px;
		border: 1px solid rgba(169, 27, 34, 0.05);
	}

	.msg-time {
		font-size: 0.65rem;
		align-self: flex-end;
		margin-top: 4px;
		opacity: 0.7;
	}

	/* Secret message style */
	.msg-secret {
		background: linear-gradient(135deg, #4a148c 0%, #a91b22 100%) !important;
		color: var(--color-white) !important;
		border: none !important;
	}

	.hidden-text {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 0.85rem;
		font-weight: 600;
		font-style: italic;
		opacity: 0.9;
	}

	.secret-badge {
		font-size: 0.7rem;
		background-color: rgba(255,255,255,0.15);
		padding: 2px 6px;
		border-radius: var(--radius-full);
		align-self: flex-start;
		margin-bottom: 4px;
		font-weight: bold;
		display: inline-flex;
		align-items: center;
		gap: 4px;
	}

	.chat-img-media {
		max-width: 100%;
		border-radius: var(--radius-md);
		display: block;
		object-fit: cover;
		max-height: 200px;
	}

	/* Input form styling */
	.chat-input-area {
		background-color: var(--color-white);
		padding: 12px;
		border-top: 1px solid rgba(169, 27, 34, 0.05);
		z-index: 10;
		transition: background-color 0.3s;
	}

	.chat-input-area.secret-active {
		background-color: rgba(74, 20, 140, 0.03);
	}

	.photo-input-bar {
		display: flex;
		align-items: center;
		gap: 10px;
		background-color: rgba(169, 27, 34, 0.03);
		padding: 6px 12px;
		border-radius: var(--radius-md);
		margin-bottom: 8px;
		border: 1px dashed rgba(169, 27, 34, 0.15);
	}

	.photo-input-bar input {
		flex-grow: 1;
		background: transparent;
		border: none;
		font-size: 0.85rem;
		color: var(--color-text);
		font-family: var(--font-main);
	}

	.photo-input-bar input:focus {
		outline: none;
	}

	.photo-input-bar button {
		background: none;
		border: none;
		font-size: 1.25rem;
		color: var(--color-text-light);
		cursor: pointer;
		padding: 0;
		box-shadow: none;
	}

	.photo-input-bar button:hover {
		background: none;
		transform: none;
		color: var(--color-primary);
		box-shadow: none;
	}

	.input-row {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.tool-btn {
		background: none;
		border: none;
		color: var(--color-text-light);
		width: 40px;
		height: 40px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		cursor: pointer;
		transition: all 0.2s;
		box-shadow: none !important;
		flex-shrink: 0 !important;
	}

	.tool-btn:hover {
		background-color: rgba(169, 27, 34, 0.05);
		transform: scale(1.05);
	}

	.tool-btn.active {
		background-color: rgba(169, 27, 34, 0.08);
		color: var(--color-primary);
	}

	.secret-toggle-btn.active {
		background-color: rgba(74, 20, 140, 0.1);
		color: #4a148c;
	}

	.chat-input-area input[type="text"] {
		flex-grow: 1;
		min-width: 0;
		padding: 10px 14px;
		border-radius: var(--radius-full);
		border: 1px solid rgba(169, 27, 34, 0.15);
		background-color: var(--color-background);
		font-size: 0.95rem;
		font-family: var(--font-main);
		color: var(--color-text);
		transition: all 0.2s;
	}

	.chat-input-area input[type="text"]:focus {
		outline: none;
		border-color: var(--color-primary);
		background-color: var(--color-white);
	}

	.send-btn {
		background-color: var(--color-primary);
		color: var(--color-white);
		border: none;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: transform 0.2s, background-color 0.2s;
		box-shadow: var(--shadow-sm);
		flex-shrink: 0 !important;
	}

	.send-btn:hover {
		background-color: var(--color-primary-light);
		transform: scale(1.05);
	}

	.send-btn:active {
		transform: scale(0.95);
	}

	/* Scrollbar styling for feed */
	.messages-feed::-webkit-scrollbar {
		width: 4px;
	}
	.messages-feed::-webkit-scrollbar-track {
		background: transparent;
	}
	.messages-feed::-webkit-scrollbar-thumb {
		background: rgba(169, 27, 34, 0.1);
		border-radius: 4px;
	}

	/* Voice Note Styles */
	.chat-audio-player {
		max-width: 100%;
		width: 220px;
		height: 40px;
		margin-top: 4px;
	}

	.msg-me .chat-audio-player {
		filter: sepia(1) saturate(3) hue-rotate(320deg) invert(1);
	}

	.msg-partner .chat-audio-player {
		filter: sepia(0.2) saturate(1.5) hue-rotate(340deg);
	}

	.audio-message-bubble {
		padding: 4px 6px;
	}

	.recording-active-row {
		background-color: rgba(169, 27, 34, 0.05);
		border-radius: var(--radius-lg);
		padding: 8px 12px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		animation: pulse-bg 2s infinite ease-in-out;
		border: 1px solid rgba(169, 27, 34, 0.1);
		width: 100%;
	}

	.recording-status {
		display: flex;
		align-items: center;
		gap: 8px;
		font-weight: 600;
		color: var(--color-primary);
		font-size: 0.9rem;
	}

	.recording-dot {
		width: 10px;
		height: 10px;
		background-color: var(--color-primary);
		border-radius: 50%;
		display: inline-block;
		animation: blink-dot 1s infinite alternate;
	}

	.recording-actions {
		display: flex;
		gap: 8px;
		align-items: center;
	}

	.cancel-record-btn {
		background: transparent;
		border: none;
		color: var(--color-text-light) !important;
		font-size: 0.85rem;
		font-weight: 600;
		cursor: pointer;
		padding: 6px 12px;
		transition: color 0.2s;
		box-shadow: none !important;
	}

	.cancel-record-btn:hover {
		color: var(--color-primary) !important;
		background: none !important;
		box-shadow: none !important;
		transform: none !important;
	}

	.stop-record-btn {
		background-color: var(--color-primary);
		color: var(--color-white);
		border: none;
		border-radius: var(--radius-full);
		padding: 6px 14px;
		font-size: 0.85rem;
		font-weight: 600;
		cursor: pointer;
		display: flex;
		align-items: center;
		gap: 6px;
		transition: background-color 0.2s;
		box-shadow: var(--shadow-sm);
	}

	.stop-record-btn:hover {
		background-color: var(--color-primary-light);
	}

	@keyframes blink-dot {
		0% { opacity: 0.2; }
		100% { opacity: 1; }
	}

	@keyframes pulse-bg {
		0% { background-color: rgba(169, 27, 34, 0.03); }
		50% { background-color: rgba(169, 27, 34, 0.08); }
		100% { background-color: rgba(169, 27, 34, 0.03); }
	}
</style>
