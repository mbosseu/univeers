---
import AppLayout from '../layouts/AppLayout.astro';
import BadgesListComponent from '../components/BadgesList.jsx';
---

<AppLayout title="Nos Succès & Badges">
	<BadgesListComponent client:load />
</AppLayout>

<style is:global>
	/* Badges styles */
	.badge-card-item {
		transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
		border-radius: var(--radius-lg);
	}

	.badge-card-item.unlocked:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-md);
		border-color: rgba(46, 125, 50, 0.3) !important;
	}

	.badge-card-item.locked {
		border: 1px dashed rgba(169, 27, 34, 0.1) !important;
	}
</style>
