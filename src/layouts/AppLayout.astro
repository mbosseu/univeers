---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Univers - Chaque geste d'amour nourrit votre flamme" />
		<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Univers</title>
		
		<!-- PWA Meta Tags -->
		<meta name="theme-color" content="#a91b22" />
		<link rel="apple-touch-icon" href="/pwa-192x192.png" />
		<link rel="manifest" href="/manifest.webmanifest" />
		
		<script is:inline>
			(function() {
				const theme = localStorage.getItem('univers-theme') || 'theme-romantic';
				const root = document.documentElement;
				if (theme === 'theme-night') {
					root.style.setProperty('--color-primary', '#0f4c81');
					root.style.setProperty('--color-primary-light', '#1a6fa0');
					root.style.setProperty('--color-background', '#f0f4f8');
				} else if (theme === 'theme-warm') {
					root.style.setProperty('--color-primary', '#8d5b4c');
					root.style.setProperty('--color-primary-light', '#a56f5e');
					root.style.setProperty('--color-background', '#FAF8F5');
				}
			})();
		</script>
	</head>
	<body>
		<!-- Global Starry Background -->
		<div id="stars-container" class="global-stars-container"></div>

		<!-- Splash Screen -->
		<div id="splash-screen" class="splash-overlay">
			<canvas id="splash-canvas" class="splash-canvas"></canvas>
			<div class="splash-content">
				<img src="/logo.webp" alt="Univers Logo" class="splash-logo-exact" />
				<p class="splash-slogan">Chaque geste d'amour nourrit votre flamme</p>
				<button id="splash-dismiss-btn" class="splash-btn">Continuer</button>
			</div>
		</div>

		<main>
			<slot />
		</main>

		<script>
			// Check if splash has already been shown in this session
			const splash = document.getElementById('splash-screen');
			if (sessionStorage.getItem('univers-splash-shown')) {
				if (splash) splash.remove();
			} else {
				const canvas = document.getElementById('splash-canvas') as HTMLCanvasElement;
				const ctx = canvas?.getContext('2d');
				
				let animationId;
				
				if (canvas && ctx) {
					const resizeCanvas = () => {
						canvas.width = window.innerWidth;
						canvas.height = window.innerHeight;
					};
					window.addEventListener('resize', resizeCanvas);
					resizeCanvas();

					const emojis = ['❤️', '💖', '💕', '💌', '🌸'];

					// Heart Particle class
					class HeartParticle {
						x = 0;
						y = 0;
						size = 0;
						speed = 0;
						opacity = 0;
						wiggle = 0;
						wiggleSpeed = 0;
						angle = 0;
						char = '❤️';

						constructor() {
							this.reset();
							this.y = Math.random() * canvas.height; // scatter at start
						}

						reset() {
							this.x = Math.random() * canvas.width;
							this.y = -30;
							this.size = Math.random() * 18 + 8;
							this.speed = Math.random() * 1.5 + 0.8;
							this.opacity = Math.random() * 0.4 + 0.2;
							this.wiggle = Math.random() * 1.5 - 0.75;
							this.wiggleSpeed = Math.random() * 0.03 + 0.01;
							this.angle = Math.random() * Math.PI;
							this.char = emojis[Math.floor(Math.random() * emojis.length)];
						}

						update() {
							this.y += this.speed;
							this.angle += this.wiggleSpeed;
							this.x += Math.sin(this.angle) * this.wiggle;
							if (this.y > canvas.height + 30) {
								this.reset();
							}
						}

						draw() {
							ctx.save();
							ctx.globalAlpha = this.opacity;
							ctx.font = `${this.size}px Arial`;
							ctx.fillText(this.char, this.x, this.y);
							ctx.restore();
						}
					}

					const hearts = Array.from({ length: 20 }, () => new HeartParticle());

					const animate = () => {
						ctx.clearRect(0, 0, canvas.width, canvas.height);
						hearts.forEach(h => {
							h.update();
							h.draw();
						});
						animationId = requestAnimationFrame(animate);
					};
					animate();

					// Reusable dismiss function
					let dismissed = false;
					const dismissSplash = () => {
						if (dismissed) return;
						dismissed = true;
						if (splash) {
							splash.classList.add('fade-out');
							setTimeout(() => {
								cancelAnimationFrame(animationId);
								window.removeEventListener('resize', resizeCanvas);
								splash.remove();
								sessionStorage.setItem('univers-splash-shown', 'true');
							}, 600);
						}
					};

					// Dismiss ONLY on button click or touch
					const dismissBtn = document.getElementById('splash-dismiss-btn');
					if (dismissBtn) {
						dismissBtn.addEventListener('click', dismissSplash);
						dismissBtn.addEventListener('touchstart', dismissSplash);
					}
				} else {
					// Fallback if no canvas support
					let dismissed = false;
					const dismissSplash = () => {
						if (dismissed) return;
						dismissed = true;
						if (splash) {
							splash.classList.add('fade-out');
							setTimeout(() => {
								splash.remove();
								sessionStorage.setItem('univers-splash-shown', 'true');
							}, 600);
						}
					};

					const dismissBtn = document.getElementById('splash-dismiss-btn');
					if (dismissBtn) {
						dismissBtn.addEventListener('click', dismissSplash);
						dismissBtn.addEventListener('touchstart', dismissSplash);
					}
				}
			}

			// --- Global Starry Background Script ---
			(function() {
				const container = document.getElementById('stars-container');
				if (!container) return;

				const numStars = 30;
				const stars = [];

				for (let i = 0; i < numStars; i++) {
					const star = document.createElement('div');
					star.className = 'bg-star';
					star.style.left = `${Math.random() * 100}vw`;
					star.style.top = `${Math.random() * 100}vh`;
					
					const size = Math.random() * 3 + 2; // 2px to 5px
					star.style.width = `${size}px`;
					star.style.height = `${size}px`;
					star.style.animationDelay = `${Math.random() * 4}s`;
					star.style.animationDuration = `${Math.random() * 3 + 3}s`;
					
					container.appendChild(star);
					stars.push(star);
				}

				// Progressive color change based on scroll position & location path
				const updateStarColors = () => {
					// Scroll fraction (0 to 1)
					const scrollPercent = window.scrollY / (document.documentElement.scrollHeight - window.innerHeight || 1);
					const scrollHue = Math.floor(scrollPercent * 180);

					// Path hash offset
					const path = window.location.pathname;
					let pathHash = 0;
					for (let i = 0; i < path.length; i++) {
						pathHash += path.charCodeAt(i);
					}
					const pathOffset = (pathHash % 12) * 30; // Distinct hue offsets for pages

					const finalHue = (scrollHue + pathOffset) % 360;
					const starColor = `hsl(${finalHue}, 100%, 75%)`;
					document.documentElement.style.setProperty('--star-color', starColor);
				};

				// Touch / Mouse interaction (changes hue locally as you swipe or move)
				const handlePointerMove = (e) => {
					const x = e.touches ? e.touches[0].clientX : e.clientX;
					const y = e.touches ? e.touches[0].clientY : e.clientY;
					
					const xPercent = x / window.innerWidth;
					const yPercent = y / window.innerHeight;
					const pointerHue = Math.floor((xPercent + yPercent) * 120);

					const scrollPercent = window.scrollY / (document.documentElement.scrollHeight - window.innerHeight || 1);
					const scrollHue = Math.floor(scrollPercent * 120);

					const path = window.location.pathname;
					let pathHash = 0;
					for (let i = 0; i < path.length; i++) {
						pathHash += path.charCodeAt(i);
					}
					const pathOffset = (pathHash % 12) * 30;

					const finalHue = (pointerHue + scrollHue + pathOffset) % 360;
					document.documentElement.style.setProperty('--star-color', `hsl(${finalHue}, 100%, 75%)`);
				};

				window.addEventListener('scroll', updateStarColors, { passive: true });
				window.addEventListener('mousemove', handlePointerMove, { passive: true });
				window.addEventListener('touchmove', handlePointerMove, { passive: true });

				// Initial color call
				updateStarColors();

				// Listen to navigation events (in case of SPA transitions)
				setInterval(updateStarColors, 1000);
			})();
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		overflow-x: hidden;
	}
	main {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	/* Splash Screen Styles */
	.splash-overlay {
		position: fixed;
		top: 0;
		left: 0;
		width: 100vw;
		height: 100vh;
		background: #fdf1e7; /* Arrière-plan beige chaud assorti exactement au logo */
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 99999;
		transition: opacity 0.6s cubic-bezier(0.25, 1, 0.5, 1), visibility 0.6s;
		overflow: hidden;
	}

	.splash-overlay.fade-out {
		opacity: 0;
		visibility: hidden;
	}

	.splash-canvas {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		z-index: 1;
	}

	.splash-content {
		position: relative;
		z-index: 2;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 16px;
	}

	.splash-logo-exact {
		max-width: 300px;
		width: 80%;
		height: auto;
		border-radius: 24px;
		box-shadow: 0 10px 30px rgba(169, 27, 34, 0.08);
		animation: pulse-logo 2.5s infinite alternate ease-in-out;
		display: block;
		border: 1px solid rgba(169, 27, 34, 0.03);
	}

	.splash-slogan {
		margin: 0;
		font-size: 0.95rem;
		color: var(--color-text-light);
		font-family: var(--font-main);
		font-weight: 500;
	}

	@keyframes pulse-logo {
		0% {
			transform: scale(1);
			box-shadow: 0 8px 25px rgba(169, 27, 34, 0.08);
		}
		100% {
			transform: scale(1.04);
			box-shadow: 0 14px 35px rgba(169, 27, 34, 0.16);
		}
	}

	/* Starry Background Styles */
	.global-stars-container {
		position: fixed;
		top: 0;
		left: 0;
		width: 100vw;
		height: 100vh;
		pointer-events: none;
		z-index: -1;
		overflow: hidden;
	}

	.bg-star {
		position: absolute;
		background: var(--star-color, #ffffff);
		border-radius: 50%;
		box-shadow: 0 0 8px var(--star-color, #ffffff), 0 0 15px var(--star-color, #ffffff);
		opacity: 0.5;
		animation: twinkle 3s infinite alternate ease-in-out;
		transition: background-color 0.8s ease, box-shadow 0.8s ease;
	}

	@keyframes twinkle {
		0% {
			opacity: 0.2;
			transform: scale(0.8);
		}
		100% {
			opacity: 0.8;
			transform: scale(1.2);
		}
	}

	.splash-btn {
		margin-top: 1.5rem;
		background-color: var(--color-primary, #a91b22);
		color: white;
		border: none;
		border-radius: 9999px;
		padding: 14px 36px;
		font-size: 1.05rem;
		font-weight: 700;
		cursor: pointer;
		box-shadow: 0 4px 15px rgba(169, 27, 34, 0.2);
		transition: all 0.2s ease;
		font-family: var(--font-main, sans-serif);
		z-index: 10;
		position: relative;
	}

	.splash-btn:hover {
		background-color: var(--color-primary-light, #d32f2f);
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(169, 27, 34, 0.3);
	}

	.splash-btn:active {
		transform: translateY(0);
	}
</style>
