---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Univers - Chaque geste d'amour nourrit votre flamme" />
		<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Univers</title>
		
		<!-- PWA Meta Tags -->
		<meta name="theme-color" content="#a91b22" />
		<link rel="apple-touch-icon" href="/pwa-192x192.png" />
		
		<script is:inline>
			(function() {
				const theme = localStorage.getItem('univers-theme') || 'theme-romantic';
				const root = document.documentElement;
				if (theme === 'theme-night') {
					root.style.setProperty('--color-primary', '#0f4c81');
					root.style.setProperty('--color-primary-light', '#1a6fa0');
					root.style.setProperty('--color-background', '#f0f4f8');
				} else if (theme === 'theme-warm') {
					root.style.setProperty('--color-primary', '#8d5b4c');
					root.style.setProperty('--color-primary-light', '#a56f5e');
					root.style.setProperty('--color-background', '#FAF8F5');
				}
			})();
		</script>
	</head>
	<body>
		<!-- Splash Screen -->
		<div id="splash-screen" class="splash-overlay">
			<canvas id="splash-canvas" class="splash-canvas"></canvas>
			<div class="splash-content">
				<div class="splash-logo-wrapper">
					<span class="splash-emoji">❤️🔥</span>
				</div>
				<h1 class="splash-title">Univers</h1>
				<p class="splash-slogan">Chaque geste d'amour nourrit votre flamme</p>
			</div>
		</div>

		<main>
			<slot />
		</main>

		<script>
			// Check if splash has already been shown in this session
			const splash = document.getElementById('splash-screen');
			if (sessionStorage.getItem('univers-splash-shown')) {
				if (splash) splash.remove();
			} else {
				const canvas = document.getElementById('splash-canvas') as HTMLCanvasElement;
				const ctx = canvas?.getContext('2d');
				
				let animationId;
				
				if (canvas && ctx) {
					const resizeCanvas = () => {
						canvas.width = window.innerWidth;
						canvas.height = window.innerHeight;
					};
					window.addEventListener('resize', resizeCanvas);
					resizeCanvas();

					const emojis = ['❤️', '💖', '💕', '💌', '🌸'];

					// Heart Particle class
					class HeartParticle {
						x = 0;
						y = 0;
						size = 0;
						speed = 0;
						opacity = 0;
						wiggle = 0;
						wiggleSpeed = 0;
						angle = 0;
						char = '❤️';

						constructor() {
							this.reset();
							this.y = Math.random() * canvas.height; // scatter at start
						}

						reset() {
							this.x = Math.random() * canvas.width;
							this.y = -30;
							this.size = Math.random() * 18 + 8;
							this.speed = Math.random() * 1.5 + 0.8;
							this.opacity = Math.random() * 0.4 + 0.2;
							this.wiggle = Math.random() * 1.5 - 0.75;
							this.wiggleSpeed = Math.random() * 0.03 + 0.01;
							this.angle = Math.random() * Math.PI;
							this.char = emojis[Math.floor(Math.random() * emojis.length)];
						}

						update() {
							this.y += this.speed;
							this.angle += this.wiggleSpeed;
							this.x += Math.sin(this.angle) * this.wiggle;
							if (this.y > canvas.height + 30) {
								this.reset();
							}
						}

						draw() {
							ctx.save();
							ctx.globalAlpha = this.opacity;
							ctx.font = `${this.size}px Arial`;
							ctx.fillText(this.char, this.x, this.y);
							ctx.restore();
						}
					}

					const hearts = Array.from({ length: 20 }, () => new HeartParticle());

					const animate = () => {
						ctx.clearRect(0, 0, canvas.width, canvas.height);
						hearts.forEach(h => {
							h.update();
							h.draw();
						});
						animationId = requestAnimationFrame(animate);
					};
					animate();

					// Fade out and clean up
					setTimeout(() => {
						if (splash) {
							splash.classList.add('fade-out');
							setTimeout(() => {
								cancelAnimationFrame(animationId);
								window.removeEventListener('resize', resizeCanvas);
								splash.remove();
								sessionStorage.setItem('univers-splash-shown', 'true');
							}, 600);
						}
					}, 2200);
				} else {
					// Fallback if no canvas support
					setTimeout(() => {
						if (splash) {
							splash.classList.add('fade-out');
							setTimeout(() => {
								splash.remove();
								sessionStorage.setItem('univers-splash-shown', 'true');
							}, 600);
						}
					}, 2200);
				}
			}
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		overflow-x: hidden;
	}
	main {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	/* Splash Screen Styles */
	.splash-overlay {
		position: fixed;
		top: 0;
		left: 0;
		width: 100vw;
		height: 100vh;
		background: linear-gradient(135deg, var(--color-background) 0%, #ffebee 100%);
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 99999;
		transition: opacity 0.6s cubic-bezier(0.25, 1, 0.5, 1), visibility 0.6s;
		overflow: hidden;
	}

	.splash-overlay.fade-out {
		opacity: 0;
		visibility: hidden;
	}

	.splash-canvas {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		z-index: 1;
	}

	.splash-content {
		position: relative;
		z-index: 2;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
	}

	.splash-logo-wrapper {
		width: 100px;
		height: 100px;
		background: white;
		border-radius: 30px;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 10px 25px rgba(169, 27, 34, 0.12);
		animation: pulse-glow 2s infinite alternate;
		border: 1px solid rgba(169, 27, 34, 0.05);
	}

	.splash-emoji {
		font-size: 3.5rem;
		line-height: 1;
	}

	.splash-title {
		margin: 0;
		font-size: 3rem;
		font-family: 'Playfair Display', 'Georgia', serif;
		color: var(--color-primary);
		font-weight: bold;
	}

	.splash-slogan {
		margin: 0;
		font-size: 0.95rem;
		color: var(--color-text-light);
		font-family: var(--font-main);
		font-weight: 500;
	}

	@keyframes pulse-glow {
		0% {
			transform: scale(1);
			box-shadow: 0 10px 25px rgba(169, 27, 34, 0.12);
		}
		100% {
			transform: scale(1.05);
			box-shadow: 0 15px 35px rgba(169, 27, 34, 0.25);
		}
	}
</style>
